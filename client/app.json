{
  "expo": {
    "splash": {
      "image": "./assets/images/LogoIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#b93838ff"
    },
    "name": "KJV Bible",
    "slug": "KJVBible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "versememorization",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      // "adaptiveIcon": {
      //   "backgroundColor": "#181818",
      //   "foregroundImage": "./assets/images/Logo.png",
      //   "backgroundImage": "./assets/images/Logo.png",
      //   "monochromeImage": "./assets/images/Logo.png"
      // },
      "splash": {
        "image": "./assets/images/LogoIcon.png",
        "resizeMode": "contain",
        "backgroundColor": "#b93838ff"
      },
      // "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.VerseApp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#b93838ff",
          "image": "./assets/images/LogoIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/LogoIcon.png",
            "backgroundColor": "#b93838ff"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/NotificationIcon.png",
          "color": "#E6F4FE",
          "sounds": []
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter/extras/ttf/Inter-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Inter/extras/ttf/Inter-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Inter/extras/ttf/Inter-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Inter/extras/ttf/Inter-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Inter/extras/ttf/Inter-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": ["./assets/fonts/Inter/extras/ttf/Inter-Regular.ttf"]
          }
        }
      ]
    ],
    // "notification": {
    //   "icon": "./assets/images/NotificationIcon.png",
    //   "color": "#E6F4FE"
    // },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c8fc25b-9e16-4d3f-bf4e-b597dd2e4027"
      }
    },
    "owner": "blindedis"
  }
}
